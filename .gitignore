# ── Repo scope: only the UF Index project lives here ────────────────
# Ignore everything at the root, then re-include the two project folders.
/*
!.gitignore
!README.md
!BACKEND_PLAN.md
!UFINDEX/
!uf-index-app/

# ── Inside the app ─────────────────────────────────────────────────
uf-index-app/node_modules/
uf-index-app/.git-scaffold-archive/
uf-index-app/.expo/
uf-index-app/dist/
uf-index-app/web-build/
uf-index-app/ios/
uf-index-app/android/
uf-index-app/*.log

# ── Inside the prototype / docs ────────────────────────────────────
UFINDEX/uf-index-prototype/node_modules/
UFINDEX/uf-index-prototype/.vercel/
UFINDEX/**/.DS_Store

# ── Never commit ───────────────────────────────────────────────────
.DS_Store
*.env
*.env.local
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
