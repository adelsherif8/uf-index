# Copy to .env and fill in from the Supabase dashboard → Project Settings → API.
# Leave these unset and the app runs exactly as it does today: fully offline,
# everything stored on the device.
#
# The ANON key is safe in the app — RLS is what protects the data.
# NEVER put the service_role key here; it bypasses RLS entirely.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
